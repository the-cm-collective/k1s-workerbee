include LICENSE
include README.md
include pyproject.toml
include docs/releasing.md
include scripts/audit_release_artifacts.py
include scripts/build_release_candidate.sh
include scripts/build_wheelhouse.sh
include scripts/install-workerbee.sh
recursive-include src/workerbee *.py
recursive-include src/workerbee/assets *.png *.webp Containerfile
recursive-include tests *.py Containerfile
prune .codex
prune .direnv
prune .eggs
prune .local
prune .mypy_cache
prune .pytest_cache
prune .ruff_cache
prune .venv
prune .venv-demo
prune .workerbee
prune build
prune dist
prune state
prune temp
prune tmp
global-exclude *.py[cod] __pycache__/* .DS_Store
