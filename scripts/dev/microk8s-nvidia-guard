#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/dev/microk8s-nvidia-guard <status|apply|rollback>

Portable guard for WorkerBee direct-containerd testing on hosts where NVIDIA GPU
Operator toolkit mutates MicroK8s containerd config. The guard is a no-op unless
MicroK8s, GPU Operator, ClusterPolicy, and a MicroK8s-targeting toolkit
DaemonSet/ClusterPolicy are detected.

Environment:
  WORKERBEE_MK8S_GUARD_STATE             State file for rollback metadata
                                          (default: /tmp/workerbee-microk8s-nvidia-guard.env)
  WORKERBEE_MK8S_GUARD_OBSERVE_SECONDS   Idle checksum observation after apply
                                          (default: 10)
  WORKERBEE_MK8S_GUARD_API_WAIT_SECONDS  Seconds to wait for MicroK8s API
                                          readiness during rollback
                                          (default: 90)
  WORKERBEE_MK8S_GUARD_ROLLBACK_ATTEMPTS Rollback kubectl retry attempts
                                          (default: 5)
  WORKERBEE_MK8S_GUARD_ROLLBACK_SLEEP    Seconds between rollback retries
                                          (default: 3)
EOF
}

cmd="${1:-status}"
case "$cmd" in
  status|apply|rollback) ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

state_file="${WORKERBEE_MK8S_GUARD_STATE:-/tmp/workerbee-microk8s-nvidia-guard.env}"
observe_seconds="${WORKERBEE_MK8S_GUARD_OBSERVE_SECONDS:-10}"
rollback_api_wait_seconds="${WORKERBEE_MK8S_GUARD_API_WAIT_SECONDS:-90}"
rollback_attempts="${WORKERBEE_MK8S_GUARD_ROLLBACK_ATTEMPTS:-5}"
rollback_sleep="${WORKERBEE_MK8S_GUARD_ROLLBACK_SLEEP:-3}"
gpu_namespace="gpu-operator-resources"
cluster_policy="cluster-policy"
helm_release="gpu-operator"
toolkit_ds="nvidia-container-toolkit-daemonset"
microk8s_template="/var/snap/microk8s/current/args/containerd-template.toml"
microk8s_rendered="/var/snap/microk8s/current/args/containerd.toml"
host_containerd="/etc/containerd/config.toml"
kustomization_records=""

k() {
  microk8s kubectl "$@"
}

say() {
  printf '%s\n' "$*"
}

jsonpath_or_empty() {
  local resource="$1"
  local path="$2"
  shift 2
  k "$@" get "$resource" -o "jsonpath=$path" 2>/dev/null || true
}

resource_exists() {
  k "$@" >/dev/null 2>&1
}

microk8s_available() {
  command -v microk8s >/dev/null 2>&1
}

microk8s_api_ready() {
  k --request-timeout=10s get nodes >/dev/null 2>&1
}

wait_microk8s_api_ready() {
  local timeout="${1:-$rollback_api_wait_seconds}"
  local deadline=$((SECONDS + timeout))
  say "rollback: waiting up to ${timeout}s for MicroK8s API"
  while true; do
    if microk8s_api_ready; then
      return 0
    fi
    if (( SECONDS >= deadline )); then
      say "rollback: MicroK8s API did not become ready within ${timeout}s"
      return 1
    fi
    say "rollback: MicroK8s API is not ready; retrying"
    sleep "$rollback_sleep"
  done
}

rollback_k() {
  local attempt rc
  for ((attempt = 1; attempt <= rollback_attempts; attempt++)); do
    if k "$@" >/dev/null; then
      return 0
    fi
    rc=$?
    if (( attempt >= rollback_attempts )); then
      say "rollback: kubectl failed after ${rollback_attempts} attempts: kubectl $*"
      return "$rc"
    fi
    say "rollback: kubectl failed on attempt ${attempt}/${rollback_attempts}; waiting for MicroK8s API"
    wait_microk8s_api_ready || true
    sleep "$rollback_sleep"
  done
}

namespace_exists() {
  resource_exists get namespace "$gpu_namespace"
}

cluster_policy_exists() {
  resource_exists get clusterpolicy "$cluster_policy"
}

toolkit_ds_exists() {
  resource_exists -n "$gpu_namespace" get daemonset "$toolkit_ds"
}

helm_release_exists() {
  resource_exists -n "$gpu_namespace" get helmrelease "$helm_release"
}

owner_kustomization_name() {
  jsonpath_or_empty "helmrelease/$helm_release" \
    '{.metadata.labels.kustomize\.toolkit\.fluxcd\.io/name}' \
    -n "$gpu_namespace"
}

owner_kustomization_namespace() {
  local namespace
  namespace="$(jsonpath_or_empty "helmrelease/$helm_release" \
    '{.metadata.labels.kustomize\.toolkit\.fluxcd\.io/namespace}' \
    -n "$gpu_namespace")"
  printf '%s' "${namespace:-flux-system}"
}

kustomization_exists() {
  local name="$1"
  local namespace="$2"
  [[ -n "$name" ]] && resource_exists -n "$namespace" get kustomization "$name"
}

kustomization_parent_name() {
  local name="$1"
  local namespace="$2"
  jsonpath_or_empty "kustomization/$name" \
    '{.metadata.labels.kustomize\.toolkit\.fluxcd\.io/name}' \
    -n "$namespace"
}

kustomization_parent_namespace() {
  local name="$1"
  local namespace="$2"
  local parent_namespace
  parent_namespace="$(jsonpath_or_empty "kustomization/$name" \
    '{.metadata.labels.kustomize\.toolkit\.fluxcd\.io/namespace}' \
    -n "$namespace")"
  printf '%s' "${parent_namespace:-flux-system}"
}

suspend_kustomization_chain() {
  local name="$1"
  local namespace="$2"
  local chain=()
  local parent_name parent_namespace item was_suspended record_prefix

  while kustomization_exists "$name" "$namespace"; do
    chain+=("$namespace/$name")
    parent_name="$(kustomization_parent_name "$name" "$namespace")"
    parent_namespace="$(kustomization_parent_namespace "$name" "$namespace")"
    if [[ -z "$parent_name" || ( "$parent_name" == "$name" && "$parent_namespace" == "$namespace" ) ]]; then
      break
    fi
    name="$parent_name"
    namespace="$parent_namespace"
  done

  for ((idx = ${#chain[@]} - 1; idx >= 0; idx--)); do
    item="${chain[$idx]}"
    namespace="${item%/*}"
    name="${item#*/}"
    was_suspended="$(jsonpath_or_empty \
      "kustomization/$name" \
      '{.spec.suspend}' \
      -n "$namespace")"
    [[ -n "$was_suspended" ]] || was_suspended="false"
    say "flux: suspending Kustomization/$name in $namespace (was suspend=$was_suspended)"
    k -n "$namespace" patch kustomization "$name" \
      --type merge \
      -p '{"spec":{"suspend":true}}' >/dev/null
    record_prefix=""
    [[ -n "$kustomization_records" ]] && record_prefix=","
    kustomization_records="${kustomization_records}${record_prefix}${namespace}/${name}:${was_suspended}"
  done
}

toolkit_enabled() {
  local enabled
  enabled="$(jsonpath_or_empty "clusterpolicy/$cluster_policy" '{.spec.toolkit.enabled}')"
  [[ "$enabled" == "true" ]]
}

helm_release_toolkit_enabled() {
  local enabled
  if ! helm_release_exists; then
    return 1
  fi
  enabled="$(jsonpath_or_empty "helmrelease/$helm_release" '{.spec.values.toolkit.enabled}' -n "$gpu_namespace")"
  [[ "$enabled" == "true" ]]
}

toolkit_targets_microk8s() {
  local policy_yaml ds_yaml hr_yaml
  policy_yaml="$(k get clusterpolicy "$cluster_policy" -o yaml 2>/dev/null || true)"
  ds_yaml="$(k -n "$gpu_namespace" get daemonset "$toolkit_ds" -o yaml 2>/dev/null || true)"
  hr_yaml="$(k -n "$gpu_namespace" get helmrelease "$helm_release" -o yaml 2>/dev/null || true)"
  grep -Fq "$microk8s_template" <<<"$policy_yaml"$'\n'"$ds_yaml"$'\n'"$hr_yaml"
}

toolkit_reconciliation_enabled() {
  toolkit_enabled || toolkit_ds_exists || helm_release_toolkit_enabled
}

detect_reason() {
  if ! microk8s_available; then
    say "not_applicable: microk8s command not found"
    return 1
  fi
  if ! microk8s_api_ready; then
    say "not_applicable: microk8s API is not responding"
    return 1
  fi
  if ! namespace_exists; then
    say "not_applicable: $gpu_namespace namespace not found"
    return 1
  fi
  if ! cluster_policy_exists; then
    say "not_applicable: ClusterPolicy/$cluster_policy not found"
    return 1
  fi
  if ! toolkit_reconciliation_enabled; then
    say "not_applicable: NVIDIA toolkit is not enabled, running, or enabled in HelmRelease values"
    return 1
  fi
  if ! toolkit_targets_microk8s; then
    say "not_applicable: NVIDIA toolkit is not targeting MicroK8s containerd config"
    return 1
  fi
  say "applicable: NVIDIA toolkit is managing MicroK8s containerd config"
  return 0
}

sha_for_path() {
  local path="$1"
  if [[ ! -e "$path" ]]; then
    printf 'missing'
    return 0
  fi
  if sudo -n true >/dev/null 2>&1; then
    sudo -n sha256sum "$path" 2>/dev/null | awk '{print $1}'
  else
    sha256sum "$path" 2>/dev/null | awk '{print $1}' || printf 'unreadable'
  fi
}

mtime_for_path() {
  local path="$1"
  if [[ ! -e "$path" ]]; then
    printf 'missing'
    return 0
  fi
  if sudo -n true >/dev/null 2>&1; then
    sudo -n stat -c '%y' "$path" 2>/dev/null || printf 'unreadable'
  else
    stat -c '%y' "$path" 2>/dev/null || printf 'unreadable'
  fi
}

print_config_fingerprints() {
  local label="$1"
  say "$label:"
  for path in "$microk8s_template" "$microk8s_rendered" "$host_containerd"; do
    say "  $path"
    say "    sha256: $(sha_for_path "$path")"
    say "    mtime:  $(mtime_for_path "$path")"
  done
}

nodes_ready() {
  k get nodes --no-headers 2>/dev/null | awk '{ if ($2 != "Ready") bad = 1 } END { exit bad }'
}

cri_plugin_ok() {
  if ! sudo -n true >/dev/null 2>&1; then
    say "warning: sudo is not cached; skipping MicroK8s CRI plugin check"
    return 0
  fi
  sudo -n /snap/microk8s/current/bin/ctr \
    --address /var/snap/microk8s/common/run/containerd.sock \
    plugins ls 2>/dev/null | awk '$1 == "io.containerd.grpc.v1" && $2 == "cri" && $NF == "ok" { found = 1 } END { exit !found }'
}

validate_microk8s_health() {
  local timeout="${1:-90}"
  local deadline=$((SECONDS + timeout))
  while (( SECONDS < deadline )); do
    if microk8s_api_ready && nodes_ready && cri_plugin_ok; then
      say "health: MicroK8s node Ready and CRI plugin ok"
      return 0
    fi
    sleep 2
  done
  say "error: MicroK8s health did not settle within ${timeout}s"
  k get nodes -o wide || true
  if sudo -n true >/dev/null 2>&1; then
    sudo -n /snap/microk8s/current/bin/ctr \
      --address /var/snap/microk8s/common/run/containerd.sock \
      plugins ls 2>/dev/null | grep -E 'io.containerd.grpc.v1[[:space:]]+cri|TYPE' || true
  fi
  return 1
}

write_state() {
  local new_kustomization_records="$1"
  local hr_present="$2"
  local hr_was_suspended="$3"
  local toolkit_was_enabled="$4"

  if [[ -f "$state_file" ]]; then
    # Preserve the original pre-guard state across repeated idempotent apply runs.
    # shellcheck disable=SC1090
    . "$state_file"
    if [[ "${GUARD_APPLIED:-0}" == "1" ]]; then
      new_kustomization_records="${KUSTOMIZATION_RECORDS:-$new_kustomization_records}"
      hr_present="${HELMRELEASE_PRESENT:-$hr_present}"
      hr_was_suspended="${HELMRELEASE_WAS_SUSPENDED:-$hr_was_suspended}"
      toolkit_was_enabled="${TOOLKIT_WAS_ENABLED:-$toolkit_was_enabled}"
    fi
  fi

  mkdir -p "$(dirname "$state_file")"
  cat >"$state_file" <<EOF
GUARD_APPLIED=1
KUSTOMIZATION_RECORDS=$new_kustomization_records
HELMRELEASE_PRESENT=$hr_present
HELMRELEASE_WAS_SUSPENDED=$hr_was_suspended
TOOLKIT_WAS_ENABLED=$toolkit_was_enabled
GPU_NAMESPACE=$gpu_namespace
CLUSTER_POLICY=$cluster_policy
HELM_RELEASE=$helm_release
TOOLKIT_DS=$toolkit_ds
EOF
}

wait_toolkit_inactive() {
  local timeout="${1:-90}"
  local deadline=$((SECONDS + timeout))
  local desired ready
  while (( SECONDS < deadline )); do
    if ! toolkit_ds_exists; then
      say "toolkit: DaemonSet is absent"
      return 0
    fi
    desired="$(jsonpath_or_empty "daemonset/$toolkit_ds" '{.status.desiredNumberScheduled}' -n "$gpu_namespace")"
    ready="$(jsonpath_or_empty "daemonset/$toolkit_ds" '{.status.numberReady}' -n "$gpu_namespace")"
    desired="${desired:-0}"
    ready="${ready:-0}"
    if [[ "$desired" == "0" || "$ready" == "0" ]]; then
      say "toolkit: DaemonSet inactive (desired=$desired ready=$ready)"
      return 0
    fi
    sleep 2
  done
  say "error: toolkit DaemonSet remained active after ${timeout}s"
  k -n "$gpu_namespace" get daemonset "$toolkit_ds" -o wide || true
  k -n "$gpu_namespace" get pods -l app="$toolkit_ds" -o wide || true
  return 1
}

apply_guard() {
  if ! detect_reason; then
    exit 0
  fi
  validate_microk8s_health 90
  print_config_fingerprints "baseline_config"

  local kustomization_name=""
  local kustomization_namespace=""
  local hr_present="0"
  local hr_was_suspended="false"
  local toolkit_was_enabled

  if helm_release_exists; then
    kustomization_name="$(owner_kustomization_name)"
    kustomization_namespace="$(owner_kustomization_namespace)"
    if kustomization_exists "$kustomization_name" "$kustomization_namespace"; then
      kustomization_records=""
      suspend_kustomization_chain "$kustomization_name" "$kustomization_namespace"
    else
      say "flux: owning Kustomization not found; continuing with HelmRelease guard only"
    fi
  fi

  if helm_release_exists; then
    hr_present="1"
    hr_was_suspended="$(jsonpath_or_empty "helmrelease/$helm_release" '{.spec.suspend}' -n "$gpu_namespace")"
    [[ -n "$hr_was_suspended" ]] || hr_was_suspended="false"
    say "flux: suspending HelmRelease/$helm_release (was suspend=$hr_was_suspended)"
    k -n "$gpu_namespace" patch helmrelease "$helm_release" \
      --type merge \
      -p '{"spec":{"suspend":true}}' >/dev/null
  else
    say "flux: HelmRelease/$helm_release not found; skipping Flux suspension"
  fi

  toolkit_was_enabled="$(jsonpath_or_empty "clusterpolicy/$cluster_policy" '{.spec.toolkit.enabled}')"
  [[ -n "$toolkit_was_enabled" ]] || toolkit_was_enabled="false"
  say "toolkit: disabling ClusterPolicy/$cluster_policy spec.toolkit.enabled (was $toolkit_was_enabled)"
  k patch clusterpolicy "$cluster_policy" \
    --type merge \
    -p '{"spec":{"toolkit":{"enabled":false}}}' >/dev/null
  wait_toolkit_inactive 90
  write_state \
    "$kustomization_records" \
    "$hr_present" \
    "$hr_was_suspended" \
    "$toolkit_was_enabled"

  validate_microk8s_health 90
  print_config_fingerprints "post_guard_config"

  local before after
  before="$(sha_for_path "$microk8s_template")"
  say "observe: waiting ${observe_seconds}s for unexpected MicroK8s containerd-template changes"
  sleep "$observe_seconds"
  after="$(sha_for_path "$microk8s_template")"
  if [[ "$before" != "$after" ]]; then
    say "error: MicroK8s containerd-template changed during observation ($before -> $after)"
    return 1
  fi
  say "guard: applied; MicroK8s containerd-template checksum stable"
}

status_guard() {
  detect_reason || true
  if [[ -f "$state_file" ]]; then
    say "guard_state: rollback metadata present at $state_file"
  fi
  if microk8s_available && microk8s_api_ready; then
    k get nodes -o wide || true
    if namespace_exists; then
      k -n "$gpu_namespace" get daemonset "$toolkit_ds" -o wide 2>/dev/null || true
      k -n "$gpu_namespace" get pods -o wide 2>/dev/null || true
    fi
    print_config_fingerprints "current_config"
  fi
}

rollback_guard() {
  if [[ ! -f "$state_file" ]]; then
    say "rollback: no guard state found at $state_file; nothing to do"
    exit 0
  fi
  # shellcheck disable=SC1090
  . "$state_file"
  if [[ "${GUARD_APPLIED:-0}" != "1" ]]; then
    say "rollback: state file does not indicate an applied guard; nothing to do"
    exit 0
  fi
  if ! microk8s_available; then
    say "error: MicroK8s is unavailable; cannot rollback guard"
    exit 1
  fi
  if ! wait_microk8s_api_ready; then
    say "error: MicroK8s is unavailable; cannot rollback guard"
    exit 1
  fi

  if [[ "${TOOLKIT_WAS_ENABLED:-false}" == "true" ]]; then
    say "rollback: re-enabling NVIDIA toolkit"
    rollback_k patch clusterpolicy "$cluster_policy" \
      --type merge \
      -p '{"spec":{"toolkit":{"enabled":true}}}'
  else
    say "rollback: toolkit was not enabled before guard; leaving disabled"
  fi

  if [[ "${HELMRELEASE_PRESENT:-0}" == "1" && "${HELMRELEASE_WAS_SUSPENDED:-false}" != "true" ]]; then
    say "rollback: resuming HelmRelease/$helm_release"
    rollback_k -n "$gpu_namespace" patch helmrelease "$helm_release" \
      --type merge \
      -p '{"spec":{"suspend":false}}'
  else
    say "rollback: HelmRelease was absent or already suspended before guard; leaving as-is"
  fi

  if [[ -n "${KUSTOMIZATION_RECORDS:-}" ]]; then
    local records record ns_name was_suspended namespace name
    IFS=',' read -r -a records <<<"${KUSTOMIZATION_RECORDS:-}"
    for ((idx = ${#records[@]} - 1; idx >= 0; idx--)); do
      record="${records[$idx]}"
      ns_name="${record%:*}"
      was_suspended="${record##*:}"
      namespace="${ns_name%/*}"
      name="${ns_name#*/}"
      if [[ "$was_suspended" != "true" ]]; then
        say "rollback: resuming Kustomization/$name in $namespace"
        rollback_k -n "$namespace" patch kustomization "$name" \
          --type merge \
          -p '{"spec":{"suspend":false}}'
      else
        say "rollback: Kustomization/$name in $namespace was already suspended before guard; leaving as-is"
      fi
    done
  elif [[ "${KUSTOMIZATION_PRESENT:-0}" == "1" && "${KUSTOMIZATION_WAS_SUSPENDED:-false}" != "true" ]]; then
    say "rollback: resuming Kustomization/${KUSTOMIZATION_NAME:-} in ${KUSTOMIZATION_NAMESPACE:-flux-system}"
    rollback_k -n "${KUSTOMIZATION_NAMESPACE:-flux-system}" patch kustomization "${KUSTOMIZATION_NAME:-}" \
      --type merge \
      -p '{"spec":{"suspend":false}}'
  fi

  validate_microk8s_health 90 || true
  say "rollback: complete"
}

case "$cmd" in
  status) status_guard ;;
  apply) apply_guard ;;
  rollback) rollback_guard ;;
esac
